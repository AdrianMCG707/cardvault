// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  authProviderId String
  createdAt      DateTime @default(now())
  binders        Binder[]
}

enum Game {
  POKEMON
  YUGIOH
  LORCANA
  ONE_PIECE
}

model Binder {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  name      String
  game      Game
  createdAt DateTime  @default(now())
  holdings  Holding[]
}

model Card {
  id             String          @id @default(uuid())
  externalId     String
  name           String
  rarity         String
  setId          String
  setName        String
  number         String?
  game           Game
  imageUrl       String?
  holdings       Holding[]
  priceSnapshots PriceSnapshot[]

  @@unique([game, externalId])
  @@index([game, setId])
}

model Holding {
  id            String   @id @default(uuid())
  binderId      String
  binder        Binder   @relation(fields: [binderId], references: [id])
  cardId        String
  card          Card     @relation(fields: [cardId], references: [id])
  variantId     String
  condition     String
  printing      String
  quantity      Int
  acquiredPrice Decimal
  addedAt       DateTime @default(now())

  @@index([binderId])
}

model PriceSnapshot {
  id         String   @id @default(uuid())
  card       Card     @relation(fields: [cardId], references: [id])
  cardId     String
  variantId  String
  price      Decimal
  capturedAt DateTime @default(now())
  source     String

  @@index([variantId, capturedAt])
}
